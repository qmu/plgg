{
  "name": "plgg-ir-diagram",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "description": "Static diagram language for graphs, nested groups and typed ports.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs.js"
      }
    },
    "./widget": {
      "import": {
        "types": "./dist/widget.d.ts",
        "default": "./dist/widget.es.js"
      },
      "require": {
        "types": "./dist/widget.d.ts",
        "default": "./dist/widget.cjs.js"
      }
    },
    "./editor": {
      "import": {
        "types": "./dist/editor.d.ts",
        "default": "./dist/editor.es.js"
      },
      "require": {
        "types": "./dist/editor.d.ts",
        "default": "./dist/editor.cjs.js"
      }
    },
    "./interactive": "./dist/browser/interactive.js",
    "./flow": {
      "import": {
        "types": "./dist/flow.d.ts",
        "default": "./dist/flow.es.js"
      },
      "require": {
        "types": "./dist/flow.d.ts",
        "default": "./dist/flow.cjs.js"
      }
    },
    "./flowEditor": {
      "import": {
        "types": "./dist/flowEditor.d.ts",
        "default": "./dist/flowEditor.es.js"
      },
      "require": {
        "types": "./dist/flowEditor.d.ts",
        "default": "./dist/flowEditor.cjs.js"
      }
    },
    "./flow-interactive": "./dist/browser/flow.js",
    "./flowSheet": {
      "import": {
        "types": "./dist/flowSheet.d.ts",
        "default": "./dist/flowSheet.es.js"
      },
      "require": {
        "types": "./dist/flowSheet.d.ts",
        "default": "./dist/flowSheet.cjs.js"
      }
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "plgg-bundle && plgg-bundle browser.config.ts",
    "test": "plgg-test src",
    "tsc": "tsc --noEmit",
    "tsc:watch": "tsc --noEmit --watch",
    "test:watch": "plgg-test src --watch",
    "coverage": "plgg-test src --coverage",
    "coverage:watch": "plgg-test src --coverage --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qmu/plgg.git"
  },
  "author": "qmu",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qmu/plgg/issues"
  },
  "homepage": "https://github.com/qmu/plgg#readme",
  "dependencies": {
    "plgg": "file:../plgg",
    "plgg-ir-syntax": "file:../plgg-ir-syntax",
    "plgg-ir-language": "file:../plgg-ir-language",
    "plgg-parser": "file:../plgg-parser",
    "plgg-view": "file:../plgg-view",
    "plgg-flow": "file:../plgg-flow",
    "plgg-board": "file:../plgg-board",
    "plggmatic": "file:../plggmatic"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "plgg-bundle": "file:../plgg-bundle",
    "plgg-test": "file:../plgg-test",
    "typescript": "^7.0.2"
  }
}

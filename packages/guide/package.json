{
  "name": "@plgg/guide",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The official user guide for plgg and the plgg family. Content is authored in Markdown; code samples are drawn from the real packages and tested examples.",
  "scripts": {
    "dev": "plggpress dev --watch-theme",
    "build": "plggpress build --config site.config.ts --contentDir . --outDir dist",
    "preview": "python3 -m http.server --directory dist",
    "serve:worker": "wrangler dev --env=\"\"",
    "serve:worker:staging": "wrangler dev --env staging",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qmu/plgg.git"
  },
  "author": "qmu",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qmu/plgg/issues"
  },
  "homepage": "https://github.com/qmu/plgg#readme",
  "dependencies": {
    "plggpress": "file:../plggpress"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.123.0"
  }
}

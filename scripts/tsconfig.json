{
  "compilerOptions": {
    /* The repository's own TS tooling scripts (publish.ts and its
       pure helpers). They run directly under Node's native
       type-stripping — never emitted — and import each other with
       explicit `.ts` specifiers, so allowImportingTsExtensions +
       noEmit.

       No `typeRoots`: it used to pin
       `../packages/plgg-bundle/node_modules/@types`, which encoded
       WHERE the install had put things. Under npm workspaces the
       shared `@types/node` hoists to the root `node_modules`, so
       that path resolves to nothing and every script fails with
       TS2688. Omitting the setting restores tsc's default — walk up
       from this directory looking for `node_modules/@types` — which
       finds the types wherever the install actually put them. */
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["*.ts"]
}
